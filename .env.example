DEBUG=true

BOT_TOKEN=
CLIENT_ID=
GUILD_ID=
GREET_CHANNEL_ID=
LOG_CHANNEL_ID=

# --- Database ---
# Default: docker compose starts a bundled Postgres for you (COMPOSE_PROFILES below),
# so DATABASE_URL can stay empty.
# External / managed Postgres: comment out COMPOSE_PROFILES and set DATABASE_URL, e.g.
#   DATABASE_URL=postgresql://user:pass@your-host:5432/boostify
# Careful: inside Docker, "localhost" points at the container itself, not your machine.
COMPOSE_PROFILES=local-db
DATABASE_URL=
